# ---------------------------------------------------------------------------
# ToptanPortal - Ortam Degiskenleri
# KVKK Md.9: Tum veri Turkiye siniri icindeki Tier-3/4 DC uzerinde tutulur.
# Bu dosya sablondur; .env dosyasi ASLA repoya commit edilmez.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# --- PostgreSQL (birincil veri deposu, TR bolgesi) ---
DATABASE_URL=postgresql://toptanportal:toptanportal@localhost:5432/toptanportal?schema=public&connection_limit=20&pool_timeout=10

# --- Redis (stok/fiyat onbellegi + oturum + rate limit + BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# --- JWT / Oturum ---
# openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_base64_64_byte_access_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_MFA_CHALLENGE_TTL=300
JWT_ISSUER=toptanportal
JWT_AUDIENCE=toptanportal-clients

# --- Alan Bazli Sifreleme (AES-256-GCM, at-rest) ---
# 32 byte anahtar, base64. Anahtar rotasyonu icin ACTIVE_KEY_ID kullanilir.
FIELD_ENCRYPTION_ACTIVE_KEY_ID=k1
FIELD_ENCRYPTION_KEYS=k1:CHANGE_ME_base64_32_byte_key
BLIND_INDEX_KEY=CHANGE_ME_base64_32_byte_hmac_key

# --- Guvenlik Politikalari ---
TRUST_CLOUDFLARE_HEADERS=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15
PASSWORD_MIN_LENGTH=10
TOTP_ISSUER=ToptanPortal
SUPER_ADMIN_IP_WHITELIST_ENFORCED=true

# --- Docker Compose port eslemeleri ---
# Makinede baska bir PostgreSQL/Redis calisiyorsa bu portlari degistirin ve
# DATABASE_URL / REDIS_PORT degerlerini de ayni portlara gore guncelleyin.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Bakim Gorevleri ---
# Gorevler coklu ornekte Redis kilidiyle tekillestirilir; her ornekte acik
# birakilabilir. Yalnizca gorevleri ayri bir surecte calistiran kurulumlarda
# kapatin: kapatmak, suresi dolan stok rezervasyonlarinin HIC serbest
# birakilmamasi demektir.
MAINTENANCE_JOBS_ENABLED=true
JOB_RESERVATION_RELEASE_SECONDS=120
JOB_IDEMPOTENCY_PURGE_SECONDS=3600
JOB_OUTBOX_WATCH_SECONDS=300
# Bu sureden uzun bekleyen outbox olayi uyari uretir.
OUTBOX_STALE_MINUTES=15

# --- Logo ERP Kopru Servisi (on-prem, mTLS) ---
LOGO_BRIDGE_BASE_URL=https://logo-bridge.internal:8443
LOGO_BRIDGE_CLIENT_CERT_PATH=./certs/portal-client.crt
LOGO_BRIDGE_CLIENT_KEY_PATH=./certs/portal-client.key
LOGO_BRIDGE_CA_PATH=./certs/logo-bridge-ca.crt
LOGO_BRIDGE_TIMEOUT_MS=4000
